(defun identical-float-p (a b)
  (and (= a b) (= (float-sign a) (float-sign b))))

(test fma-reference-and-dispatch
  (dolist (type '(single-float double-float))
    (let ((seed 54))
      (flet ((next () (setf seed (mod (+ (* seed 1664525) 1013904223) (expt 2 32)))))
        (dotimes (i 1024)
          (let* ((limit (if (eq type 'single-float) 60 500))
                 (values (loop repeat 3 collect
                           (scale-float (coerce (/ (- (mod (next) 513) 256) 256) type)
                                        (- (mod (next) (* 2 limit)) limit))))
                 (expected (apply #'simd::portable-fma values)))
            (dolist (mode '(:portable :native :auto))
              (let ((simd::*fma-mode* mode))
                (is (identical-float-p expected (apply #'simd:fma values)))))
            (when (< i 16)
              (dolist (backend (available-backends))
                (dolist (mode '(:portable :native :auto))
                  (let ((simd::*fma-mode* mode)
                        (out (make-array 5 :element-type type)))
                    (with-backend (backend)
                      (apply #'kernel-true-fma out
                             (mapcar (lambda (v) (make-array 5 :element-type type :initial-element v)) values)))
                    (is (every (lambda (v) (identical-float-p expected v)) out)))))))))))
  (dolist (values '((1 2 3) (1.0 2.0d0 3.0) (1.0d0 2.0 3.0d0)))
    (signals error (apply #'simd:fma values)))
  (let ((simd::*native-fma-available-p* nil)
        (simd::*sbcl-fma-available-p* nil))
    (is (= (simd::portable-fma 1.0 2.0 3.0) (simd:fma 1.0 2.0 3.0)))))

